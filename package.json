{
  "name": "expo-firebase-template",
  "main": "index.js",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client --lan --port 8081",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest",
    "build:dev:android": "eas build --profile development --platform android",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:prod:android": "eas build --profile production --platform android",
    "build:prod:ios": "eas build --profile production --platform ios",
    "build:prod-apk:android": "eas build --profile production-apk --platform android",
    "update:dev": "eas update --channel development --environment development",
    "update:preview": "eas update --channel preview --environment preview",
    "firebase:deploy": "firebase deploy --only firestore:rules,firestore:indexes,storage,functions",
    "firebase:sync": "node scripts/sync-firebase-native-configs.mjs",
    "firebase:sync:eas": "node scripts/sync-firebase-native-configs.mjs --upload-eas",
    "sync:src": "bash scripts/sync-src-from-gemfort.sh",
    "sync:skills": "bash scripts/sync-skills-from-gemfort.sh"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "26.0.0",
    "@react-native-firebase/app-check": "26.0.0",
    "@react-native-firebase/auth": "26.0.0",
    "@react-native-firebase/firestore": "26.0.0",
    "@react-native-firebase/phone-number-verification": "26.0.0",
    "@react-native-firebase/storage": "26.0.0",
    "@react-native-vector-icons/material-icons": "^13.1.2",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.101.2",
    "expo": "~57.0.8",
    "expo-adi-registration": "^1.0.0",
    "expo-apple-authentication": "~57.0.1",
    "expo-build-properties": "~57.0.7",
    "expo-constants": "~57.0.7",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.9",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-picker": "~57.0.6",
    "expo-linking": "~57.0.4",
    "expo-notifications": "~57.0.7",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-updates": "~57.0.8",
    "firebase": "^12.0.0",
    "react": "19.2.0",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-nitro-google-signin": "^1.3.0",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "sonner-native": "^0.26.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jest": "29",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.0",
    "firebase-tools": "^15.22.4",
    "jest": "29",
    "jest-expo": "~57.0.2",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react-native-screens": "~4.26.0"
  }
}
