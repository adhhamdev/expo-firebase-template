# App environment: development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Firebase Web config (Console → Project settings → Your apps → Web)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional: Firebase Phone Number Verification test token (dev only, SIM-less)
# Console → Phone Number Verification → test session
# EXPO_PUBLIC_FIREBASE_PNV_TEST_TOKEN=
