# Firebase Web config
# Console → Project settings → Your apps → Web app
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# App Check debug token (simulators / emulators / CI)
# Console → App Check → your app → ⋮ → Manage debug tokens → Generate
# Leave empty in production release builds.
# EXPO_PUBLIC_FIREBASE_APP_CHECK_DEBUG_TOKEN=

# Optional: Phone Number Verification test token (dev only, SIM-less)
# Console → Authentication → Phone Number Verification → test session
# EXPO_PUBLIC_FIREBASE_PNV_TEST_TOKEN=
